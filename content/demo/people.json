 "comments": {
  "hh-juniper-2am": [
   {
    "by": "maya-chen",
    "text": "The Rhodes at 2am is a genre of its own. Please keep the tape hiss.",
    "ago": "1h"
   },
   {
    "by": "rosa-lindqvist",
    "text": "Already know this one is going to wreck me.",
    "ago": "3h"
   },
   {
    "by": "juniper-vale",
    "text": "tape hiss stays. promise.",
    "ago": "2h"
   },
   {
    "by": "jonah-bell",
    "text": "That chord at 0:41. Twice.",
    "ago": "5h"
   }
  ],
  "hh-cass-bridge": [
   {
    "by": "theo-okafor",
    "text": "Del is right. Give it the extra eight bars.",
    "ago": "2h"
   },
   {
    "by": "elliot-park",
    "text": "Would happily listen to forty minutes of this exact loop.",
    "ago": "6h"
   },
   {
    "by": "cass-ferro",
    "text": "Del says thank you. I say we'll see.",
    "ago": "4h"
   }
  ],
  "hh-imani-radio": [
   {
    "by": "priya-nair",
    "text": "The tuning dial on that one. Unreal.",
    "ago": "40m"
   },
   {
    "by": "sofia-reyes",
    "text": "Episode about restoring it please?",
    "ago": "2h"
   },
   {
    "by": "small-machines",
    "text": "Already recording it. Valves arrive Thursday.",
    "ago": "1h"
   }
  ],
  "hh-teodora-soundcheck": [
   {
    "by": "rosa-lindqvist",
    "text": "See you in that enormous room tonight, front left.",
    "ago": "20m"
   },
   {
    "by": "maya-chen",
    "text": "The reverb in there is doing half the work. Gorgeous.",
    "ago": "1h"
   },
   {
    "by": "teodora-blue",
    "text": "front left gets the encore wave.",
    "ago": "12m"
   }
  ],
  "hh-priya-walk": [
   {
    "by": "priya-nair",
    "text": "Thinking-out-loud walks are my favourite part of this show. More of these.",
    "ago": "2h"
   },
   {
    "by": "amara-diallo",
    "text": "These voice notes are better than most finished podcasts.",
    "ago": "4h"
   }
  ],
  "hh-marlow-porch": [
   {
    "by": "jonah-bell",
    "text": "The wind deserves a writing credit.",
    "ago": "1h"
   },
   {
    "by": "marlow-saltwater",
    "text": "splitting it 50/50 with the wind, yes.",
    "ago": "50m"
   },
   {
    "by": "maya-chen",
    "text": "Porch versions forever.",
    "ago": "3h"
   }
  ],
  "hh-yemi-rehearsal": [
   {
    "by": "amara-diallo",
    "text": "Kunle, put this groove on the record. Please.",
    "ago": "30m"
   },
   {
    "by": "theo-okafor",
    "text": "Danced in my kitchen to a phone recording. No regrets.",
    "ago": "2h"
   }
  ],
  "hh-halden-tape": [
   {
    "by": "sofia-reyes",
    "text": "Rain from last April, looped on a four-track. This is the whole mood.",
    "ago": "1h"
   },
   {
    "by": "elliot-park",
    "text": "Put this on for focus and forgot to work.",
    "ago": "5h"
   }
  ],
  "hh-juniper-lyrics": [
   {
    "by": "rosa-lindqvist",
    "text": "The coffee ring is the best part of the lyric sheet.",
    "ago": "1d"
   },
   {
    "by": "jonah-bell",
    "text": "Crossed-out line in verse two is a whole other song.",
    "ago": "1d"
   }
  ],
  "hh-kitchen-whiteboard": [
   {
    "by": "priya-nair",
    "text": "Zooming in on the arrows like it's a treasure map.",
    "ago": "3h"
   },
   {
    "by": "kitchen-table",
    "text": "There is a method. We think.",
    "ago": "2h"
   }
  ]
 },

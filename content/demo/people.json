 "comments": {
  "ic-ellis-session": [
   {
    "by": "maya-chen",
    "text": "Leaving the crack in is the whole point. Please never fix it.",
    "ago": "2h"
   },
   {
    "by": "rosa-lindqvist",
    "text": "Already know this one is going to wreck me.",
    "ago": "3h"
   },
   {
    "by": "ellis-rae",
    "text": "it stays. promise.",
    "ago": "5h"
   },
   {
    "by": "jonah-bell",
    "text": "That breath before the chorus. Twice.",
    "ago": "8h"
   }
  ],
  "ic-ellis-rehearsal": [
   {
    "by": "rosa-lindqvist",
    "text": "Danny on guitar is the secret weapon.",
    "ago": "2h"
   },
   {
    "by": "jonah-bell",
    "text": "The chord change at 0:07 is a whole other song.",
    "ago": "3h"
   }
  ],
  "ic-halyards-soundcheck": [
   {
    "by": "theo-okafor",
    "text": "That window light should get a writing credit.",
    "ago": "2h"
   },
   {
    "by": "elliot-park",
    "text": "Would happily listen to forty minutes of this soundcheck.",
    "ago": "3h"
   },
   {
    "by": "the-halyards",
    "text": "Mira says thank you. The light says nothing.",
    "ago": "5h"
   }
  ],
  "ic-halyards-crowd": [
   {
    "by": "sofia-reyes",
    "text": "I was in that crowd. Still can’t hear properly.",
    "ago": "2h"
   },
   {
    "by": "elliot-park",
    "text": "Undertow live is a different animal.",
    "ago": "3h"
   }
  ],
  "ic-nova-dance": [
   {
    "by": "rosa-lindqvist",
    "text": "See you in that room tonight, front left.",
    "ago": "2h"
   },
   {
    "by": "maya-chen",
    "text": "The choreo is going to be everywhere by summer.",
    "ago": "3h"
   },
   {
    "by": "nova-lin",
    "text": "front left gets the encore wave.",
    "ago": "5h"
   }
  ],
  "ic-juniper-lowe-street": [
   {
    "by": "jonah-bell",
    "text": "The kid dancing deserves a writing credit.",
    "ago": "2h"
   },
   {
    "by": "juniper-lowe",
    "text": "splitting it 50/50 with the kid, yes.",

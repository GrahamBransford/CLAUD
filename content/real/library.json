{
  "about": "CIRCA's creator library: every creator and every video in the demo. All media is stored inside the app (public/media/live), so it plays anywhere, including inside the claude.ai preview. Run `npm run content:demo` after editing.",
  "howTo": {
    "addCreator": "Copy a creator block, give it a new id, and list its content. Songs go to Music and the Radio, episodes to the Radio, innerCircle posts to Inner Circle.",
    "playback": "video: a file in public/media (src + poster). youtube: an official YouTube upload by videoId (plays only where YouTube's player is allowed; not in the claude.ai preview). instagram: an official Instagram embed by url.",
    "innerCircle": "Behind-the-scenes only: rehearsals, studio sessions, soundchecks, tour moments. Never a polished video or a full episode.",
    "credits": "Every item records where its footage and music come from and under what licence. The app lists them in Settings, Credits."
  },
  "sources": {
    "artists": "Demo identities (names, bios and captions are invented) on licensed stock footage of real performers from Mixkit, with licensed music from Mixkit's composers. The performers are not the people named.",
    "podcasts": "Real NASA shows and episodes, excerpted (five minutes each). NASA media is public domain; NASA does not endorse CIRCA."
  },
  "display": {
    "note": "How videos sit in the vertical feeds. fill: cropped to fill the screen. fit: whole, with a soft glow in the creator's colours around it.",
    "artist": "fill",
    "podcast": "fit"
  },
